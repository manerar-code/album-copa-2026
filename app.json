{
  "expo": {
    "name": "Álbum Copa 2026",
    "slug": "album-copa-2026",
    "version": "1.0.0",
    "scheme": "album-copa-2026",
    "newArchEnabled": false,
    "experiments": {
      "typedRoutes": false
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manera.albumcopa2026",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.manera.albumcopa2026",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "privacyPolicyUrl": "https://album-copa-2026-sable.vercel.app/privacy-policy",
    "extra": {
      "eas": {
        "projectId": "758486d3-d924-4d75-b91a-a32c41f7ae0b"
      }
    },
    "owner": "manerar",
    "plugins": [
      "expo-web-browser",
      "expo-sqlite",
      "expo-font",
      "./plugins/withFollyFix"
    ]
  }
}
